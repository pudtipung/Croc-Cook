{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/im/(.*)",
      "dest": "/im/$1"
    },
    {
      "src": "/logo.png",
      "dest": "/logo.png"
    },
    {
      "src": "/padped.jpg",
      "dest": "/padped.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
