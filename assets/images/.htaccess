# ป้องกันการรันสคริปต์ในโฟลเดอร์เก็บรูปภาพ
<FilesMatch "\.(php|php5|php7|php8|phtml|phps|cgi|pl|py|sh|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# ปิดการทำงานของ PHP engine ถ้าเปิดใช้งานโมดูล php
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI

